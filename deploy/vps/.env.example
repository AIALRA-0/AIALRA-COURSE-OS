COURSE_OS_COMPOSE_PROJECT=course-os
COURSE_OS_PUBLIC_HOST=course.example.com
COURSE_OS_RUNTIME_IMAGE=course-os-runtime:2.4.0-0123456
COURSE_OS_CONVERTER_IMAGE=course-os-converter:2.4.0-0123456
COURSE_OS_API_BIND=127.0.0.1:14100
COURSE_OS_WEB_BIND=127.0.0.1:14173
COURSE_OS_WORKSPACE_ID=personal
COURSE_OS_SECRET_DIR=./secrets
COURSE_OS_PRIVATE_NETWORK=private-network
MODEL_ROUTER_NETWORK=model-router-network
MODEL_ROUTER_URL=http://model-router:8080
COURSE_OS_ALLOW_AIALRA_EMERGENCY=false
READWEAVE_NETWORK=readweave_default
READWEAVE_BASE_URL=http://readweave:8080
READWEAVE_PUBLIC_URL=https://readweave.example.com
READWEAVE_ROOT_NOTE_ID=root
