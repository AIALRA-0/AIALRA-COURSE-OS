{
  "type": "object",
  "properties": {
    "chapterBridgeMarkdown": { "type": "string" },
    "learningObjectives": { "type": "array", "items": { "type": "string" } },
    "mainContentMarkdown": { "type": "string", "minLength": 1 },
    "priorKnowledge": { "type": "array", "items": { "type": "string" } },
    "fullExplanationMarkdown": { "type": "string", "minLength": 1 },
    "misconceptions": { "type": "array", "items": { "type": "string" } },
    "coverageEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "atomId": { "type": "string", "minLength": 1 },
          "coveredFields": { "type": "array", "items": { "type": "string" } },
          "explanation": { "type": "string", "minLength": 1 }
        },
        "required": ["atomId", "coveredFields", "explanation"],
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "enum": ["comprehension", "multiple_choice"] },
          "prompt": { "type": "string", "minLength": 1 },
          "options": { "type": "array", "items": { "type": "string" } },
          "expectedAnswer": { "type": "string", "minLength": 1 },
          "explanation": { "type": "string", "minLength": 1 }
        },
        "required": ["kind", "prompt", "options", "expectedAnswer", "explanation"],
        "additionalProperties": false
      }
    }
  },
  "required": ["chapterBridgeMarkdown", "learningObjectives", "mainContentMarkdown", "priorKnowledge", "fullExplanationMarkdown", "misconceptions", "coverageEvidence", "questions"],
  "additionalProperties": false
}
