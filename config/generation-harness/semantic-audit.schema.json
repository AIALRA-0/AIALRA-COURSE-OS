{
  "type": "object",
  "properties": {
    "sourceChecks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "claim": { "type": "string" },
          "evidence": { "type": "string" },
          "verdict": { "type": "string", "enum": ["supported", "contradicted", "unverified"] }
        },
        "required": ["claim", "evidence", "verdict"],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "field": { "type": "string" },
          "original": { "type": "string" },
          "replacement": { "type": "string" },
          "evidence": { "type": "string" }
        },
        "required": ["field", "original", "replacement", "evidence"],
        "additionalProperties": false
      }
    }
  },
  "required": ["sourceChecks", "findings"],
  "additionalProperties": false
}
