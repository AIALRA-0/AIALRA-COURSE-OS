# Course OS HTTP API address used by the browser application
VITE_API_BASE_URL=http://127.0.0.1:4100

# Local API binding and durable private state location
COURSE_OS_HOST=127.0.0.1
COURSE_OS_PORT=4100
COURSE_OS_DATA_DIR=./var

# PostgreSQL is required by the production profile
DATABASE_URL=postgresql://course_os:change-me@127.0.0.1:5432/course_os

# ReadWeave remains the semantic authority; local development can use the file adapter
READWEAVE_MODE=file
READWEAVE_BASE_URL=http://127.0.0.1:37840
READWEAVE_API_TOKEN=
READWEAVE_ROOT_NOTE_ID=root
READWEAVE_PUBLIC_URL=https://readweave.example.com
COURSE_OS_WORKSPACE_ID=personal

# The EE680 source stays outside Git and is imported into ignored content storage
EE680_SOURCE_DIR=D:/private/ee680/lecture

# Approved writing skill directory used only to create a versioned policy snapshot
HUMAN_READABLE_SKILL_DIR=D:/tools/skills/human-readable-technical-writing
