{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://course-os.invalid/schemas/release-manifest.schema.json",
  "title": "Course OS ReleaseManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schemaVersion", "courseReleaseId", "sourceHashes", "pageHashes", "explanationHashes", "assessmentHashes", "writingPolicySnapshotId", "modelRoutes", "qualityHarnessVersion", "costInputs", "createdAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "schemaVersion": { "enum": ["2.1.0", "2.2.0", "2.3.0", "2.4.0"] },
    "courseReleaseId": { "type": "string", "minLength": 1 },
    "sourceHashes": { "$ref": "#/$defs/hashes" },
    "pageHashes": { "$ref": "#/$defs/hashes" },
    "explanationHashes": { "$ref": "#/$defs/hashes" },
    "assessmentHashes": { "$ref": "#/$defs/hashes" },
    "writingPolicySnapshotId": { "type": "string", "minLength": 1 },
    "modelRoutes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "qualityHarnessVersion": { "type": "string", "minLength": 1 },
    "costInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "model", "inputTokens", "outputTokens", "costUsd"],
        "properties": {
          "provider": { "type": "string" },
          "model": { "type": "string" },
          "inputTokens": { "type": "integer", "minimum": 0 },
          "outputTokens": { "type": "integer", "minimum": 0 },
          "costUsd": { "type": "number", "minimum": 0 }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "hashes": { "type": "array", "items": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" } }
  }
}
